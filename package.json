{
  "name": "@beibingyangliuying/dsh-sidebar-pdf-nav",
  "version": "0.1.0",
  "description": "PDF outline (bookmark) navigation, thumbnails and full-text search for the DSH sidebar document preview.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "client",
    "assets",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "check": "node --check client/client.js && node --check lib/index.js && node --check lib/assets.js"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.0 <0.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beibingyangliuying/dsh-pdf-reader.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
